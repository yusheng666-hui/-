{
  "expo": {
    "name": "雨声",
    "slug": "yushengchi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "emotional-rescue",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emotional.rescue"
    },
    "android": {
      "package": "com.emotional.rescue",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "SEND",
          "category": "DEFAULT",
          "data": {
            "mimeType": "text/plain"
          }
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-quick-actions",
      "./plugins/withWidget.js",
      ["expo-build-properties", {
        "android": {
          "enableJetifier": true
        }
      }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f544738-2f4d-4c27-8759-3ea634398a78"
      }
    },
    "owner": "yushengchis-organization"
  }
}
